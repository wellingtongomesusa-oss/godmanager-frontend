# Copie para `.env` ou `.env.local` na raiz do GodManager e preencha.

# Postgres (obrigatório para login e API). Em dev, DATABASE_URL deve apontar para a BD
# onde corres `next dev`; use DATABASE_URL_LOCAL + scripts npm (db:local:* / dev:local)
# para nunca aplicar migrações acidentalmente na produção.
# Com docker compose na raiz:
# DATABASE_URL="postgresql://godmanager:godmanager@127.0.0.1:5433/godmanager?schema=public"
DATABASE_URL=

# Local Postgres (docker-compose up -d postgres; porta 5433 no host)
DATABASE_URL_LOCAL=postgresql://godmanager:godmanager@127.0.0.1:5433/godmanager?schema=public

# QuickBooks (Intuit Developer) — OAuth2
QB_CLIENT_ID=
QB_CLIENT_SECRET=
# Deve bater EXATAMENTE com o Redirect URI registrado no Intuit Developer.
# Produção: https://www.godmanager.us/api/quickbooks/callback
QB_REDIRECT_URI=http://localhost:3101/api/quickbooks/callback
# sandbox | production
QB_ENVIRONMENT=sandbox
# Produção: https://quickbooks.api.intuit.com
QB_BASE_URL=https://sandbox-quickbooks.api.intuit.com

# ─── Cloudflare R2 (Photo Storage) ──────────────────────
# Get these values from Cloudflare R2 dashboard:
# https://dash.cloudflare.com → R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=godmanager-properties
R2_ENDPOINT=
R2_PUBLIC_URL=

# Assinatura HMAC do cookie de sessão. Opcional: se vazio, usa ENCRYPTION_KEY.
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# Cron secret for GET /api/analytics/snapshot?secret=
CRON_SECRET=
# Fallback alert recipient if no active super_admin (optional)
ANALYTICS_ALERT_EMAIL=

# --- Plaid (vincular contas bancárias) ---
# https://dashboard.plaid.com → Team Settings → Keys
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# --- Plaid Transfer (débito/crédito ACH) — MOVE DINHEIRO REAL ---
# Deixe false até o produto Transfer ser aprovado no Plaid e testado em sandbox.
# Só com "true" as rotas de transferência funcionam.
PLAID_TRANSFER_ENABLED=false
# Plaid Statements (extratos PDF) — add-on: só ative depois de habilitar o produto na conta Plaid.
PLAID_STATEMENTS_ENABLED=false
# Segredo do webhook: use a URL .../api/plaid/transfers/webhook?secret=ESSE_VALOR no Plaid.
PLAID_WEBHOOK_SECRET=

# --- E-mail (Resend) — cobrança de inquilinos + notificações ---
# https://resend.com → API Keys. Sem esta chave nenhum e-mail é enviado.
RESEND_API_KEY=
# Remetente. O domínio (godmanager.us) precisa estar VERIFICADO no Resend (SPF/DKIM),
# senão o Resend só entrega para o e-mail dono da conta. Ex.: billing@godmanager.us
RESEND_FROM_EMAIL=billing@godmanager.us
# Remetente específico da COBRANÇA de atrasados (delinquency). Default contact@godmanager.us.
# O domínio precisa estar verificado no Resend (SPF/DKIM) para entregar.
DELINQUENCY_FROM_EMAIL=contact@godmanager.us

# --- Caixa de Entrada de invoices (ingestão por e-mail) ---
# Segredo do webhook de inbound email. O provedor (SendGrid Inbound Parse / Mailgun Routes /
# AWS SES+SNS) encaminha o e-mail recebido em w@godmanager.us para:
#   POST https://www.godmanager.us/api/billing/inbox/ingest?secret=ESSE_VALOR
# Sem esta variável a ingestão fica DESABILITADA (endpoint responde 503). Gere com: openssl rand -hex 32
BILLING_INBOX_SECRET=
# Endereço geral da empresa onde fornecedores enviam faturas (ex.: contact@godmanager.us).
# Faturas enviadas para este endereço são roteadas para o responsável abaixo.
BILLING_INBOX_ADDRESS=contact@godmanager.us
# E-mail do usuário (login) cuja Caixa de Entrada recebe as faturas do endereço geral.
# Se vazio, cai no primeiro super_admin. Ex.: w@godmanager.us
BILLING_INBOX_OWNER_EMAIL=
